{
  "name": "feishu-agent-notifier",
  "displayName": "Feishu Agent Notifier",
  "description": "Send Codex and Claude Code messages to Feishu in realtime and securely resume local sessions from quoted replies.",
  "version": "0.14.0",
  "publisher": "local",
  "author": "max-well-d",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/max-well-d/vscode-feishu-agent-notifier.git"
  },
  "homepage": "https://github.com/max-well-d/vscode-feishu-agent-notifier#readme",
  "bugs": {
    "url": "https://github.com/max-well-d/vscode-feishu-agent-notifier/issues"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "keywords": [
    "feishu",
    "lark",
    "codex",
    "claude-code",
    "notification",
    "remote-control"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:feishuAgentNotifier.installHooks",
    "onCommand:feishuAgentNotifier.uninstallHooks",
    "onCommand:feishuAgentNotifier.testNotification",
    "onCommand:feishuAgentNotifier.testLocalNotification",
    "onCommand:feishuAgentNotifier.storeSecrets",
    "onCommand:feishuAgentNotifier.clearSecrets",
    "onCommand:feishuAgentNotifier.openSettings",
    "onCommand:feishuAgentNotifier.configureRemoteControl",
    "onCommand:feishuAgentNotifier.showStatus",
    "onCommand:feishuAgentNotifier.toggleWorkspacePause",
    "onCommand:feishuAgentNotifier.runDiagnostics",
    "onCommand:feishuAgentNotifier.retryPending",
    "onCommand:feishuAgentNotifier.clearPending",
    "onCommand:feishuAgentNotifier.showRemoteSessions",
    "onCommand:feishuAgentNotifier.cancelRemoteReplies"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "feishuAgentNotifier.installHooks",
        "title": "飞书 Agent 通知：安装/更新 Codex 与 Claude Code 通知接入"
      },
      {
        "command": "feishuAgentNotifier.uninstallHooks",
        "title": "飞书 Agent 通知：卸载通知接入"
      },
      {
        "command": "feishuAgentNotifier.testNotification",
        "title": "飞书 Agent 通知：发送测试消息"
      },
      {
        "command": "feishuAgentNotifier.testLocalNotification",
        "title": "飞书 Agent 通知：发送本地测试提醒"
      },
      {
        "command": "feishuAgentNotifier.storeSecrets",
        "title": "飞书 Agent 通知：安全保存飞书凭据"
      },
      {
        "command": "feishuAgentNotifier.clearSecrets",
        "title": "飞书 Agent 通知：清除安全凭据"
      },
      {
        "command": "feishuAgentNotifier.openSettings",
        "title": "飞书 Agent 通知：打开设置"
      },
      {
        "command": "feishuAgentNotifier.configureRemoteControl",
        "title": "飞书 Agent 通知：配置远程操控"
      },
      {
        "command": "feishuAgentNotifier.showStatus",
        "title": "飞书 Agent 通知：打开状态与操作菜单"
      },
      {
        "command": "feishuAgentNotifier.toggleWorkspacePause",
        "title": "飞书 Agent 通知：暂停/恢复当前工作区通知"
      },
      {
        "command": "feishuAgentNotifier.runDiagnostics",
        "title": "飞书 Agent 通知：运行自检与修复"
      },
      {
        "command": "feishuAgentNotifier.retryPending",
        "title": "飞书 Agent 通知：重试待处理通知"
      },
      {
        "command": "feishuAgentNotifier.clearPending",
        "title": "飞书 Agent 通知：清除待处理通知"
      },
      {
        "command": "feishuAgentNotifier.showRemoteSessions",
        "title": "飞书 Agent 通知：查看可远程回复的 Agent 会话"
      },
      {
        "command": "feishuAgentNotifier.cancelRemoteReplies",
        "title": "飞书 Agent 通知：取消远程回复任务"
      }
    ],
    "walkthroughs": [
      {
        "id": "feishuAgentNotifier.gettingStarted",
        "title": "配置 Feishu Agent Notifier",
        "description": "完成凭据、测试、Agent 接入和自检，避免任务结束后漏掉通知。",
        "steps": [
          {
            "id": "feishuAgentNotifier.credentials",
            "title": "安全保存飞书凭据",
            "description": "运行[安全保存飞书凭据](command:feishuAgentNotifier.storeSecrets)，凭据将写入 VS Code SecretStorage。",
            "completionEvents": [
              "onCommand:feishuAgentNotifier.storeSecrets"
            ]
          },
          {
            "id": "feishuAgentNotifier.test",
            "title": "发送飞书测试消息",
            "description": "运行[发送测试消息](command:feishuAgentNotifier.testNotification)，确认机器人权限和目标配置正确。",
            "completionEvents": [
              "onCommand:feishuAgentNotifier.testNotification"
            ]
          },
          {
            "id": "feishuAgentNotifier.remoteControl",
            "title": "可视化配置远程操控",
            "description": "可选：运行[远程操控配置向导](command:feishuAgentNotifier.configureRemoteControl)，设置安全模式、通知目标和用户/群聊白名单。",
            "completionEvents": [
              "onCommand:feishuAgentNotifier.configureRemoteControl"
            ]
          },
          {
            "id": "feishuAgentNotifier.hooks",
            "title": "接入 Codex 与 Claude Code",
            "description": "运行[安装或更新通知接入](command:feishuAgentNotifier.installHooks)，合并用户级配置且保留原有 Hook。",
            "completionEvents": [
              "onCommand:feishuAgentNotifier.installHooks"
            ]
          },
          {
            "id": "feishuAgentNotifier.diagnostics",
            "title": "运行完整自检",
            "description": "运行[自检与修复](command:feishuAgentNotifier.runDiagnostics)，检查接收器、飞书配置、Hooks 和离线队列。",
            "completionEvents": [
              "onCommand:feishuAgentNotifier.runDiagnostics"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Feishu Agent Notifier",
      "type": "object",
      "properties": {
        "feishuAgentNotifier.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "order": 1,
          "description": "启动本机通知接收器并发送飞书通知。"
        },
        "feishuAgentNotifier.deliveryMode": {
          "type": "string",
          "enum": [
            "webhook",
            "app"
          ],
          "enumDescriptions": [
            "飞书群自定义机器人。目标群由 Webhook 决定，配置最简单。",
            "飞书自建应用机器人。可通过 receiveId 指定用户、邮箱或群聊。"
          ],
          "default": "webhook",
          "scope": "machine",
          "order": 2,
          "description": "飞书投递模式。"
        },
        "feishuAgentNotifier.deliveryTiming": {
          "type": "string",
          "enum": [
            "realtime",
            "completion"
          ],
          "enumDescriptions": [
            "实时转发主 Agent 产生的每条 assistant 文本消息，包括 Codex commentary 和 final answer；不发送思考、工具参数、工具输出或用户输入。",
            "仅在 Agent 当前任务结束或失败时发送最后一条 assistant 消息。"
          ],
          "default": "realtime",
          "scope": "machine",
          "order": 3,
          "description": "Agent 消息的投递时机。Codex 结束消息优先使用官方 Stop Hook，并保留 notify 回退；实时过程使用 transcript。Claude Code 按版本选择 MessageDisplay 或 transcript。"
        },
        "feishuAgentNotifier.receiveIdType": {
          "type": "string",
          "enum": [
            "open_id",
            "user_id",
            "email",
            "chat_id"
          ],
          "default": "chat_id",
          "scope": "machine",
          "order": 22,
          "description": "应用机器人目标 ID 类型。"
        },
        "feishuAgentNotifier.receiveId": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 23,
          "description": "应用机器人的目标用户、邮箱或群聊 ID。"
        },
        "feishuAgentNotifier.remoteExecutionPolicy": {
          "type": "string",
          "enum": [
            "disabled",
            "planOnly",
            "inherit"
          ],
          "enumDescriptions": [
            "关闭飞书入站消息和远程 Agent 回复。",
            "允许回复，但 Codex 使用只读沙箱、Claude Code 使用 plan 权限模式。",
            "允许回复并继承本机 Agent 配置。远程指令可能修改文件或执行命令。"
          ],
          "default": "disabled",
          "scope": "machine",
          "order": 24,
          "description": "飞书远程回复的执行权限。仅自建应用机器人模式支持。"
        },
        "feishuAgentNotifier.remoteAllowedUserOpenIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ou_" },
          "uniqueItems": true,
          "default": [],
          "scope": "machine",
          "order": 25,
          "description": "允许提交远程回复的飞书用户 open_id 白名单。为空时拒绝所有入站消息。"
        },
        "feishuAgentNotifier.remoteAllowedChatIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^oc_" },
          "uniqueItems": true,
          "default": [],
          "scope": "machine",
          "order": 26,
          "description": "允许远程回复的群聊 chat_id 白名单。单聊不需要填写。"
        },
        "feishuAgentNotifier.remoteRequireGroupMention": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "order": 27,
          "description": "群聊远程回复必须 @机器人；建议保持开启。"
        },
        "feishuAgentNotifier.remoteReplyTimeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240,
          "default": 30,
          "scope": "machine",
          "order": 28,
          "description": "单条飞书远程 Agent 回复的最长运行分钟数。"
        },
        "feishuAgentNotifier.remoteActiveWaitMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "default": 120,
          "scope": "machine",
          "order": 29,
          "description": "目标会话正在运行时，远程回复等待权威完成事件的最长分钟数；不会再用 transcript 文件静默时间猜测结束。"
        },
        "feishuAgentNotifier.codexExecutablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 30,
          "description": "可选的 Codex CLI 绝对路径。留空时自动查找 OpenAI VS Code 扩展内置 CLI 和 PATH。"
        },
        "feishuAgentNotifier.claudeExecutablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 31,
          "description": "可选的 Claude Code CLI 绝对路径。留空时自动查找 Claude Code VS Code 扩展内置 CLI 和 PATH。"
        },
        "feishuAgentNotifier.projectDestinations": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" },
          "scope": "machine",
          "order": 32,
          "description": "可选的项目路由：键为项目名或绝对路径，值为飞书 chat_id；仅应用机器人模式生效。"
        },
        "feishuAgentNotifier.port": {
          "type": "integer",
          "default": 37561,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "machine",
          "order": 40,
          "description": "VS Code 本地通知接收器端口，仅监听 127.0.0.1。修改后需要重新安装通知接入。"
        },
        "feishuAgentNotifier.messageFormat": {
          "type": "string",
          "enum": [
            "card",
            "text"
          ],
          "enumDescriptions": [
            "飞书消息卡片：渲染 Markdown，并把 Markdown 表格转换为卡片原生表格。",
            "兼容模式：按原始纯文本发送，不渲染 Markdown。"
          ],
          "default": "card",
          "scope": "machine",
          "order": 31,
          "description": "飞书通知的展示格式。"
        },
        "feishuAgentNotifier.includeMetadata": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "order": 32,
          "description": "在完整回复之前附加 Agent、项目、状态和时间。"
        },
        "feishuAgentNotifier.maxChunkCharacters": {
          "type": "integer",
          "default": 3000,
          "minimum": 1000,
          "maximum": 20000,
          "scope": "machine",
          "order": 33,
          "description": "每条飞书文本消息的最大字符数。更长的最终回复会自动分片，内容不会截断。"
        },
        "feishuAgentNotifier.notifyOnFailure": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "order": 34,
          "description": "Claude Code StopFailure 等失败事件也发送通知。"
        },
        "feishuAgentNotifier.watchCodexIde": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "order": 35,
          "description": "completion 模式下监听 Codex IDE transcript 的 task_complete 事件。realtime 模式始终监听 transcript，以逐条发送 assistant 文本。"
        },
        "feishuAgentNotifier.localNotificationMode": {
          "type": "string",
          "enum": [
            "always",
            "whenUnfocused",
            "off"
          ],
          "enumDescriptions": [
            "每次 Agent 完成或失败时都显示 VS Code 本地提醒。",
            "仅当 VS Code 窗口失去焦点时显示本地提醒。",
            "关闭本地提醒；飞书推送不受影响。"
          ],
          "default": "always",
          "scope": "machine",
          "order": 36,
          "description": "Codex 或 Claude Code 结束时的 VS Code 本地提醒策略。"
        },
        "feishuAgentNotifier.localNotificationPreviewCharacters": {
          "type": "integer",
          "default": 160,
          "minimum": 0,
          "maximum": 500,
          "scope": "machine",
          "order": 37,
          "description": "本地提醒中显示的最终回复预览字符数；设为 0 时只显示工具、状态和项目。"
        },
        "feishuAgentNotifier.localNotificationRealtime": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "order": 38,
          "description": "实时投递模式下，每条过程消息也显示 VS Code 本地弹窗。默认关闭以避免频繁打扰；飞书实时发送不受影响。"
        },
        "feishuAgentNotifier.queueWhenOffline": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "order": 39,
          "description": "VS Code 未运行或本地接收器不可用时，将完整 Agent 事件暂存到扩展私有目录，并在下次启动后补投。关闭可避免在磁盘上暂存回复正文。"
        },
        "feishuAgentNotifier.deliveryMaxAttempts": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 5,
          "scope": "machine",
          "order": 40,
          "description": "飞书网络错误、限流或服务端错误的最大请求次数。"
        },
        "feishuAgentNotifier.retryBaseDelayMs": {
          "type": "integer",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "scope": "machine",
          "order": 41,
          "description": "飞书临时错误重试的初始等待时间（毫秒），后续按指数退避。"
        },
        "feishuAgentNotifier.deliveryErrorNotificationCooldownMinutes": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "scope": "machine",
          "order": 42,
          "description": "自动投递持续失败时，VS Code 错误弹窗的最小间隔（分钟）；完整错误始终写入日志。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --external:./larkSdk --outfile=dist/extension.js && esbuild src/larkSdk.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/larkSdk.js",
    "vscode:prepublish": "npm run compile && npm run bundle",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:integration": "npm run compile && npm run bundle && node out/test/runIntegrationTests.js",
    "check-package": "npm run bundle && vsce ls --no-dependencies",
    "package": "npm run compile && npm run bundle && vsce package --no-dependencies"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.106.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
